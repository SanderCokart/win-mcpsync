      let j = i + 1;
      for (;;) {
        while (j < t.length && /\s/.test(t[j])) j++;
        if (t[j] === '/' && t[j + 1] === '/') { while (j < t.length && t[j] !== '\n') j++; continue; }
        if (t[j] === '/' && t[j + 1] === '*') { j += 2; while (j < t.length && !(t[j] === '*' && t[j + 1] === '/')) j++; j += 2; continue; }
