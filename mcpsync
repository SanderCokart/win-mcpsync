}
const secretish = k => /(key|token|secret|passw)/i.test(k) || /^authorization$/i.test(k);
function literalSecrets(s) {
  const found = [];
  for (const [k, v] of Object.entries(s.env || {})) if (secretish(k) && typeof v === 'string' && v && !hasRef(v)) found.push('env.' + k);
  for (const [k, v] of Object.entries(s.headers || {})) if (secretish(k) && typeof v === 'string' && !hasRef(v)) found.push('headers.' + k);
  if (typeof s.url === 'string' && /[?&][^=&]*(key|token|secret)[^=&]*=[^&]/i.test(s.url) && !hasRef(s.url)) found.push('url');
  if ((s.args || []).some(x => typeof x === 'string' && /(key|token|secret)[^=]*=./i.test(x) && !hasRef(x))) found.push('args');
  return found;
}

// ---------- commands
const [op, ...a] = process.argv.slice(2);
const readSrc = f => parseJsonFile(f).data;
switch (op) {
  case 'validate': {
    const src = readSrc(a[0]), sup = a[1].split(','), probs = [];
    if (!isObj(src)) fail(a[0] + ' must contain a JSON object');
    if (src.mcpServers !== undefined && !isObj(src.mcpServers)) probs.push('  "mcpServers" must be an object');
    for (const [n, s] of Object.entries(isObj(src.mcpServers) ? src.mcpServers : {})) {
      if (!isObj(s)) { probs.push('  ' + n + ': must be an object'); continue; }
      if (!s.command && !s.url) probs.push('  ' + n + ': needs "command" (local server) or "url" (remote server)');
      for (const e of [].concat(s['x-editors'] || [], s['x-exclude-editors'] || []))
        if (!sup.includes(e)) probs.push('  ' + n + ': unknown editor "' + e + '"');
    }
    out(probs.join('\n'));
    break;
  }
  case 'generate': {
    const [srcFile, ed, pol, plat, wrap] = a;
    out(JSON.stringify(generate(readSrc(srcFile), ed, pol, plat, wrap === 'true')));
    break;
  }
  case 'gen': {
    const g = JSON.parse(readText(a[0]));
    if (a[1] === 'warnings') out(g.warnings.join('\n'));
    else if (a[1] === 'skipped') out(g.skipped.join('\n'));
    else if (a[1] === 'count') out(String(Object.keys(g.servers).length));
    break;
  }
  case 'plan': {
    const [fmt, key, file, genFile, stateFile, stateKey, newF, befF, aftF] = a;
    const gen = JSON.parse(readText(genFile));
    const prev = ((readState(stateFile)[stateKey] || {}).servers) || [];
    const r = fmt === 'toml' ? planToml(readText(file), gen, prev) : planJson(file, key, gen, prev);
    fs.writeFileSync(newF, r.newText);
    fs.writeFileSync(befF, r.before);
    fs.writeFileSync(aftF, r.after);
    const notes = r.takeover.map(n => 'takeover\t' + n);
    if (r.jsonc) notes.push('jsonc\t-');
    out(notes.join('\n'));
    break;
  }
  case 'state-set': {
    const [stateFile, stateKey, file, genFile] = a;
    const st = readState(stateFile);
    st[stateKey] = { file, servers: Object.keys(JSON.parse(readText(genFile)).servers).sort(), synced_at: new Date().toISOString() };
    fs.writeFileSync(stateFile + '.tmp', JSON.stringify(st, null, 2) + '\n');
    fs.renameSync(stateFile + '.tmp', stateFile);
    break;
  }
  case 'names': out(refNames(readSrc(a[0]).mcpServers || {}).join('\n')); break;
  case 'count': out(String(Object.keys(readSrc(a[0]).mcpServers || {}).length)); break;
  case 'list': {
    const rows = [];
    for (const [n, s] of Object.entries(readSrc(a[0]).mcpServers || {})) {
      const ex = s['x-exclude-editors'];
      rows.push([n, norm(s).type,
        (s['x-editors'] || ['all']).join(',') + (ex && ex.length ? ' -' + ex.join(',-') : ''),
        refNames(s).join(',') || '-'].join('\t'));
    }
    out(rows.join('\n'));
    break;
  }
  case 'risky': {
    const found = new Set();
    for (const [n, s] of Object.entries(readSrc(a[0]).mcpServers || {}))
      for (const str of [s.url].concat(Object.values(s.headers || {})))
        if (typeof str === 'string')
          for (const m of str.matchAll(REF))
            if (/^(ANTHROPIC_|CLAUDE_|AWS_|GOOGLE_APPLICATION)|_PROXY$|^NPM_TOKEN$/.test(m[1])) found.add(n + ': ' + m[1]);
    out([...found].join('\n'));
    break;
  }
  case 'import': {
    const [ed, fmt, key, edFile, srcFile, force, newSrc] = a;
    const txt = readText(edFile);
    if (txt === null) fail('not found: ' + edFile);
    const servers = fmt === 'toml' ? parseTomlServers(txt) : ((parseJsonFile(edFile).data || {})[key] || {});
    const srcData = readText(srcFile) === null ? { mcpServers: {} } : readSrc(srcFile);
    const cur = isObj(srcData.mcpServers) ? srcData.mcpServers : {};
    const merged = Object.assign({}, cur), lines = [];
    for (const [n, s] of Object.entries(servers)) {
      if (!isObj(s)) continue;
      if (n in cur && force !== 'true') { lines.push('kept\t' + n); continue; }
      const conv = fromEditor(ed, s);
      lines.push((n in cur ? 'replaced\t' : 'added\t') + n);
      merged[n] = conv;
      for (const p of literalSecrets(conv)) lines.push('secret\t' + n + '.' + p);
    }
    srcData.mcpServers = merged;
    fs.writeFileSync(newSrc, JSON.stringify(srcData, null, 2) + '\n');
    out(lines.join('\n'));
    break;
  }
  default: fail('unknown engine op: ' + op);
}
NODE_ENGINE

setup_engine() {
  command -v node >/dev/null 2>&1 ||
