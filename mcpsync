#!/usr/bin/env bash
# mcpsync — define your MCP servers once, sync them to every editor you use.
#
# Source of truth : ~/.config/mcpsync/mcp.json   (or <project>/.mcpsync.json with --project)
# Settings        : ~/.config/mcpsync/config      (which editors you use, fallback policy, ...)
# Secrets         : referenced as ${VAR} / ${VAR:-default}; values live in your environment
#                   (Windows user env + WSLENV, or ~/.config/mcpsync/secrets.env elsewhere)
#
# Requires: bash 3.2+ and Node.js 16+ (already needed by npx-based MCP servers).
# Works in Git Bash on Windows, WSL, macOS and Linux. Run `mcpsync help`.
set -euo pipefail

MCPSYNC_VERSION="0.2.0"
MCPSYNC_HOME="${MCPSYNC_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/mcpsync}"
SOURCE_FILE="${MCPSYNC_SOURCE:-$MCPSYNC_HOME/mcp.json}"
CONFIG_FILE="$MCPSYNC_HOME/config"
STATE_FILE="$MCPSYNC_HOME/state.json"
BACKUP_DIR="$MCPSYNC_HOME/backups"
SECRETS_FILE="$MCPSYNC_HOME/secrets.env"

SUPPORTED_EDITORS=(claude-code cursor codex claude-desktop vscode gemini devin)

# Defaults; $CONFIG_FILE overrides them.
EDITORS=""
FALLBACK="skip"
BACKUPS=10
NPX_WRAP_EDITORS=""

SCOPE="user"
PROJECT_DIR=""
STATE_PREFIX=""
TMPROOT=""
ENGINE=""

# ---------------------------------------------------------------- output
if [[ -t 2 ]]; then
  C_R=$'\e[31m' C_Y=$'\e[33m' C_G=$'\e[32m' C_B=$'\e[1m' C_D=$'\e[2m' C_0=$'\e[0m'
else
  C_R="" C_Y="" C_G="" C_B="" C_D="" C_0=""
fi
info() { printf '%s\n' "$*" >&2; }
ok()   { printf '%s✓%s %s\n' "$C_G" "$C_0" "$*" >&2; }
warn() { printf '%s!%s %s\n' "$C_Y" "$C_0" "$*" >&2; }
bad()  { printf '%s✗%s %s\n' "$C_R" "$C_0" "$*" >&2; }
die()  { printf '%serror:%s %s\n' "$C_R" "$C_0" "$*" >&2; exit 1; }

# ---------------------------------------------------------------- platform
detect_platform() {
  case "$(uname -s)" in
    Darwin) echo mac ;;
    MINGW*|MSYS*|CYGWIN*) echo windows ;;
    Linux) if grep -qi microsoft /proc/version 2>/dev/null; then echo wsl; else echo linux; fi ;;
    *) echo unknown ;;
  esac
}
PLATFORM="$(detect_platform)"

to_unix_path() {
  if [[ -n $1 ]] && command -v cygpath >/dev/null 2>&1; then cygpath -u "$1"; else printf '%s\n' "$1"; fi
}
win_appdata() {
  if [[ -n ${APPDATA:-} ]]; then to_unix_path "$APPDATA"; else printf '%s\n' "$HOME/AppData/Roaming"; fi
}
xdg_config() { printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}"; }
codex_home() {
  if [[ -n ${CODEX_HOME:-} ]]; then to_unix_path "$CODEX_HOME"; else printf '%s\n' "$HOME/.codex"; fi
}

# ---------------------------------------------------------------- editors
is_supported() { local e; for e in "${SUPPORTED_EDITORS[@]}"; do [[ $e == "$1" ]] && return 0; done; return 1; }
is_enabled()   { [[ " $EDITORS " == *" $1 "* ]]; }
servers_key()  { if [[ $1 == vscode ]]; then echo servers; else echo mcpServers; fi; }
editor_format() { if [[ $1 == codex ]]; then echo toml; else echo json; fi; }

# Prints the config file an editor reads for the current scope ("" = editor has none).
editor_file() {
  local ed=$1 var
  if [[ $SCOPE == project ]]; then
    case $ed in
      claude-code)    printf '%s\n' "$PROJECT_DIR/.mcp.json" ;;
      cursor)         printf '%s\n' "$PROJECT_DIR/.cursor/mcp.json" ;;
      codex)          printf '%s\n' "$PROJECT_DIR/.codex/config.toml" ;;
      vscode)         printf '%s\n' "$PROJECT_DIR/.vscode/mcp.json" ;;
      gemini)         printf '%s\n' "$PROJECT_DIR/.gemini/settings.json" ;;
      devin)          printf '%s\n' "$PROJECT_DIR/.devin/mcp_config.json" ;;
      claude-desktop) printf '\n' ;;
      *) die "unknown editor: $ed" ;;
    esac
    return 0
  fi
  var="PATH_$(printf '%s' "$ed" | tr 'a-z-' 'A-Z_')"
  if [[ -n ${!var:-} ]]; then to_unix_path "${!var}"; return 0; fi
  case $ed in
    claude-code)
      if [[ -n ${CLAUDE_CONFIG_DIR:-} ]]; then printf '%s\n' "$(to_unix_path "$CLAUDE_CONFIG_DIR")/.claude.json"
      else printf '%s\n' "$HOME/.claude.json"; fi ;;
    cursor) printf '%s\n' "$HOME/.cursor/mcp.json" ;;
    codex)  printf '%s\n' "$(codex_home)/config.toml" ;;
    claude-desktop)
      case $PLATFORM in
        mac)     printf '%s\n' "$HOME/Library/Application Support/Claude/claude_desktop_config.json" ;;
        windows) printf '%s\n' "$(win_appdata)/Claude/claude_desktop_config.json" ;;
        *)       printf '%s\n' "$(xdg_config)/Claude/claude_desktop_config.json" ;;
      esac ;;
    vscode)
      case $PLATFORM in
        mac)     printf '%s\n' "$HOME/Library/Application Support/Code/User/mcp.json" ;;
        windows) printf '%s\n' "$(win_appdata)/Code/User/mcp.json" ;;
        *)       printf '%s\n' "$(xdg_config)/Code/User/mcp.json" ;;
      esac ;;
    gemini) printf '%s\n' "$HOME/.gemini/settings.json" ;;
    devin)
      case $PLATFORM in
        windows) printf '%s\n' "$(win_appdata)/devin/mcp_config.json" ;;
        *)       printf '%s\n' "$(xdg_config)/devin/mcp_config.json" ;;
      esac ;;
    *) die "unknown editor: $ed (supported: ${SUPPORTED_EDITORS[*]})" ;;
  esac
}

editor_detected() {
  local ed=$1 f
  f="$(editor_file "$ed")"
  [[ -n $f && -e $f ]] && return 0
  case $ed in
    claude-code)    command -v claude >/dev/null 2>&1 ;;
    cursor)         [[ -d $HOME/.cursor ]] || command -v cursor >/dev/null 2>&1 ;;
    codex)          [[ -d $(codex_home) ]] || command -v codex >/dev/null 2>&1 ;;
    claude-desktop) [[ -n $f && -d $(dirname "$f") ]] ;;
    vscode)         [[ -d $(dirname "$f") ]] || command -v code >/dev/null 2>&1 ;;
    gemini)         [[ -d $HOME/.gemini ]] || command -v gemini >/dev/null 2>&1 ;;
    devin)          [[ -d $(dirname "$f") ]] || command -v devin >/dev/null 2>&1 ;;
    *)              return 1 ;;
  esac
}

# ---------------------------------------------------------------- engine (Node.js)
# All JSON/TOML work happens here. Written to a temp file at startup and run with `node`.
read -r -d '' ENGINE_JS <<'NODE_ENGINE' || true
'use strict';
const fs = require('fs');

