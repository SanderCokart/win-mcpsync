  major="$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null | tr -d '\r')"
  [[ ${major:-0} -ge 16 ]] || die "Node.js 16+ is required (found $(node --version 2>/dev/null | tr -d '\r'))"
