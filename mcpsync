// ---------- planning: remove what we wrote last time, keep the rest, add the current set
function planJson(file, key, gen, prev) {
  const { data, jsonc } = parseJsonFile(file);
  if (!isObj(data)) fail(file + ' must contain a JSON object');
  const cur = isObj(data[key]) ? data[key] : {};
  const next = {};
  for (const [k, v] of Object.entries(cur)) if (!prev.includes(k) && !(k in gen.servers)) next[k] = v;
  Object.assign(next, gen.servers);
  const res = Object.assign({}, data); res[key] = next;
  return {
    newText: JSON.stringify(res, null, 2) + '\n',
    takeover: Object.keys(gen.servers).filter(n => n in cur && !prev.includes(n)),
    jsonc,
    before: JSON.stringify(sortKeys(cur), null, 2) + '\n',
    after: JSON.stringify(sortKeys(next), null, 2) + '\n',
