  const blocks = tomlBlocks(text);
  const existing = new Set(blocks.filter(isServerBlock).map(b => b.path[1]));
  const drop = new Set(prev.concat(Object.keys(gen.servers)));
  // A dropped block keeps its trailing comment lines: they usually describe the next table.
  const tail = b => {
    let k = b.lines.length;
    while (k > 1 && /^\s*(#.*)?$/.test(b.lines[k - 1])) k--;
    const t = b.lines.slice(k);
    return t.some(l => l.trim().startsWith('#')) ? t : [];
  };
  const lines = trimEnd(blocks.flatMap(b => (isServerBlock(b) && drop.has(b.path[1]) ? tail(b) : b.lines)));
  for (const [name, o] of Object.entries(gen.servers)) { if (lines.length) lines.push(''); lines.push(...serverToml(name, o)); }
  const newText = lines.length ? lines.join(eol) + eol : '';
  return {
    newText,
    takeover: Object.keys(gen.servers).filter(n => existing.has(n) && !prev.includes(n)),
    jsonc: false,
    before: tomlSection(text),
    after: tomlSection(newText),
  };
}

// ---------- editor -> source (import)
function fromEditor(ed, s) {
  let o = mapStr(s, unEnv);
  if (ed === 'gemini') {
    o = mapStr(o, x => x.replace(/\$([A-Za-z_][A-Za-z0-9_]*)/g, (_, n) => '${' + n + '}'));
    if (o.httpUrl) { o.url = o.httpUrl; o.type = 'http'; delete o.httpUrl; } else if (o.url) o.type = 'sse';
  } else if (ed === 'devin' && o.transport) {
    o.type = o.transport; delete o.transport;
  } else if (ed === 'codex') {
    if (Array.isArray(o.env_vars)) {
      o.env = Object.assign({}, o.env);
      for (const v of o.env_vars) { const n = typeof v === 'string' ? v : (v && v.name); if (n) o.env[n] = '${' + n + '}'; }
      delete o.env_vars;
    }
    if (o.url) {
      o.type = 'http';
      const h = Object.assign({}, o.http_headers);
      for (const [k, n] of Object.entries(o.env_http_headers || {})) h[k] = '${' + n + '}';
      if (o.bearer_token_env_var) h.Authorization = 'Bearer ${' + o.bearer_token_env_var + '}';
      if (Object.keys(h).length) o.headers = h;
      delete o.http_headers; delete o.env_http_headers; delete o.bearer_token_env_var;
    }
  }
  if (o.command) delete o.type;
