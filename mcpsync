have_powershell() { command -v powershell.exe >/dev/null 2>&1; }
on_windows_env() { [[ $PLATFORM == windows || $PLATFORM == wsl ]] && have_powershell; }

# Runs a PowerShell snippet. Values travel via MCPSYNC_NAME / MCPSYNC_VAL env vars, never argv.
ps_run() {
  local enc
  enc="$(printf '%s' "$1" | iconv -f UTF-8 -t UTF-16LE | base64 | tr -d '\r\n')"
  if [[ $PLATFORM == wsl ]]; then
    WSLENV="${WSLENV:+$WSLENV:}MCPSYNC_NAME:MCPSYNC_VAL" \
      powershell.exe -NoProfile -NonInteractive -EncodedCommand "$enc" | tr -d '\r'
  else
    MSYS2_ENV_CONV_EXCL='MCPSYNC_VAL' MSYS_NO_PATHCONV=1 \
      powershell.exe -NoProfile -NonInteractive -EncodedCommand "$enc" | tr -d '\r'
  fi
}

# ---------------------------------------------------------------- files & state
load_config() {
  if [[ -f $CONFIG_FILE ]]; then
    # shellcheck disable=SC1090
    . "$CONFIG_FILE"
  fi
  return 0
}

require_source() {
  [[ -f $SOURCE_FILE ]] || die "no source config at $SOURCE_FILE. Run: mcpsync$([[ $SCOPE == project ]] && echo ' --project') init"
}

validate_source() {
  local problems
  problems="$(engr validate "$SOURCE_FILE" "$(IFS=,; echo "${SUPPORTED_EDITORS[*]}")")"
  [[ -z $problems ]] || die "problems in $SOURCE_FILE:"$'\n'"$problems"
}

write_file() { # write_file <target> <file-with-content> — atomic, follows symlinks
  local target=$1 content=$2 real dir out
  real="$target"
  if [[ -L $target ]]; then real="$(readlink -f "$target")"; fi
  dir="$(dirname "$real")"
  mkdir -p "$dir"
  out="$(mktemp "$dir/.mcpsync.XXXXXX")"
  cat "$content" > "$out"
  if [[ -e $real ]]; then chmod --reference="$real" "$out" 2>/dev/null || true; fi
  mv -f "$out" "$real"
}

backup_file() { # backup_file <file> <label>
  local f=$1 label=$2 ext dest old
  [[ -f $f ]] || return 0
  ext="${f##*.}"
  mkdir -p "$BACKUP_DIR"
  dest="$BACKUP_DIR/$label.$(date +%Y%m%d-%H%M%S).$ext"
  cp -p "$f" "$dest"
  chmod 600 "$dest" 2>/dev/null || true
  ls -1t "$BACKUP_DIR/$label".*."$ext" 2>/dev/null | tail -n +$((BACKUPS + 1)) |
    while IFS= read -r old; do rm -f -- "$old"; done
  return 0
}

backup_label() { # editor -> filename-safe label
  local b
  if [[ $SCOPE == project ]]; then
    b="$(basename "$PROJECT_DIR")"
    printf '%s.%s' "${b//[^A-Za-z0-9._-]/_}" "$1"
  else
    printf '%s' "$1"
  fi
}

# ---------------------------------------------------------------- planning
generate() { # editor -> writes {servers, warnings, skipped} JSON to stdout
  local ed=$1 wrap=false w
  for w in $NPX_WRAP_EDITORS; do if [[ $w == "$ed" ]]; then wrap=true; fi; done
  if [[ $PLATFORM != windows ]]; then wrap=false; fi
  eng generate "$SOURCE_FILE" "$ed" "$FALLBACK" "$PLATFORM" "$wrap"
}

# plan_one <editor> — sets P_FILE P_FMT P_GEN P_NEW P_BEFORE P_AFTER P_NOTES
plan_one() {
  local ed=$1
  P_FILE="$(editor_file "$ed")"
  P_FMT="$(editor_format "$ed")"
  P_GEN="$TMPROOT/$ed.gen.json"
  P_NEW="$TMPROOT/$ed.new"
  P_BEFORE="$TMPROOT/$ed.before"
  P_AFTER="$TMPROOT/$ed.after"
  P_NOTES="$TMPROOT/$ed.notes"
  generate "$ed" > "$P_GEN"
  engr plan "$P_FMT" "$(servers_key "$ed")" "$P_FILE" "$P_GEN" "$STATE_FILE" "$STATE_PREFIX$ed" \
    "$P_NEW" "$P_BEFORE" "$P_AFTER" > "$P_NOTES"
}
plan_changed() { ! cmp -s "$P_BEFORE" "$P_AFTER"; }

sync_one() { # sync_one <editor> <dry:true|false>
  local ed=$1 dry=$2 f kind val line
  is_supported "$ed" || die "unknown editor: $ed (supported: ${SUPPORTED_EDITORS[*]})"
  f="$(editor_file "$ed")"
  if [[ -z $f ]]; then warn "$ed has no project-level MCP file; skipped"; return 0; fi
  plan_one "$ed"

  engr gen "$P_GEN" warnings | while IFS= read -r line; do warn "$ed › $line"; done
  while IFS=$'\t' read -r kind val; do
    case $kind in
      takeover) warn "$ed › '$val' already exists there and will be replaced by the one in your source" ;;
      jsonc) warn "$ed › $P_FILE has comments or trailing commas; they'll be removed on write (a backup is kept)" ;;
    esac
  done < "$P_NOTES"

  if ! plan_changed; then
    ok "$ed: up to date  ${C_D}$P_FILE${C_0}"
  elif [[ $dry == true ]]; then
    info "${C_B}$ed${C_0} → $P_FILE ${C_D}(dry run)${C_0}"
    diff -u -L "current" -L "after sync" "$P_BEFORE" "$P_AFTER" || true
  else
    backup_file "$P_FILE" "$(backup_label "$ed")"
    write_file "$P_FILE" "$P_NEW"
    ok "$ed: $(engr gen "$P_GEN" count) server(s) → $P_FILE"
  fi
  if [[ $dry != true ]]; then
    mkdir -p "$MCPSYNC_HOME"
    eng state-set "$STATE_FILE" "$STATE_PREFIX$ed" "$P_FILE" "$P_GEN"
  fi
  return 0
}

# ---------------------------------------------------------------- commands
cmd_sync() {
  local dry=false eds=() a ed
  for a in "$@"; do
    case $a in
      -n|--dry-run) dry=true ;;
      -*) die "unknown option: $a" ;;
      *) eds+=("$a") ;;
    esac
  done
  require_source
  validate_source
  if ((${#eds[@]} == 0)); then
    [[ -n ${EDITORS// /} ]] || die "no editors configured. Run: mcpsync init   (or pass editor names)"
    read -r -a eds <<< "$EDITORS"
  fi
  for ed in "${eds[@]}"; do sync_one "$ed" "$dry"; done
  if [[ $dry == false ]]; then info "${C_D}Fully quit and reopen the editors to load the changes.${C_0}"; fi
}

cmd_status() {
  require_source
  validate_source
  local ed st en f
  printf '%-15s %-8s %-12s %s\n' EDITOR ENABLED STATE FILE
  for ed in "${SUPPORTED_EDITORS[@]}"; do
    en=no; if is_enabled "$ed"; then en=yes; fi
    if [[ $en == no ]] && ! editor_detected "$ed"; then continue; fi
    f="$(editor_file "$ed")"
    if [[ -z $f ]]; then continue; fi
    plan_one "$ed"
    if [[ ! -e $P_FILE ]]; then st="not created"
    elif plan_changed; then st="out of sync"
    else st="in sync"; fi
    printf '%-15s %-8s %-12s %s\n' "$ed" "$en" "$st" "$P_FILE"
  done
}

cmd_list() {
  require_source
  validate_source
  { printf 'NAME\tTYPE\tEDITORS\tVARIABLES\n'; engr list "$SOURCE_FILE"; } |
    if command -v column >/dev/null 2>&1; then column -t -s $'\t'; else cat; fi
}

cmd_editors() {
  local ed d en f
  for ed in "${SUPPORTED_EDITORS[@]}"; do
    d=no;  if editor_detected "$ed"; then d=yes; fi
    en=no; if is_enabled "$ed"; then en=yes; fi
    f="$(editor_file "$ed")"
    printf '%-15s detected=%-4s enabled=%-4s %s\n' "$ed" "$d" "$en" "${f:-(no project-level file)}"
  done
}

write_config() { # write_config "<editors>"
  cat > "$CONFIG_FILE" <<EOF
# mcpsync settings (sourced by bash)

# Editors to sync. Supported: ${SUPPORTED_EDITORS[*]}
EDITORS="$1"

# When an editor can't expand a \${VAR} reference
# (Claude Desktop: anywhere; Codex: anything except NAME="\${NAME}" env entries,
#  Authorization="Bearer \${X}" and Header="\${X}"):
#   skip    - leave that server out for that editor (default; never writes secrets to disk)
#   resolve - write the current value in plaintext (only for user-level files)
#   keep    - write \${VAR} as-is (the editor will see the literal text)
FALLBACK="skip"

# Timestamped backups kept per editor in $BACKUP_DIR
BACKUPS=10

# Windows only: editors where "npx ..." becomes "cmd /c npx ..." (e.g. "claude-code codex")
NPX_WRAP_EDITORS=""

# Override where an editor's user-level config lives (Windows or Unix paths both work):
# PATH_CURSOR="\$HOME/.cursor/mcp.json"
# PATH_CODEX="\$HOME/.codex/config.toml"
# PATH_VSCODE="\$APPDATA/Code - Insiders/User/mcp.json"
EOF
}

cmd_init() {
  local chosen="" force=false from="" ed d ans p=""
  while (($#)); do
    case $1 in
      --editors) chosen=${2:-}; shift 2 || die "$1 needs a value" ;;
      --editors=*) chosen=${1#*=}; shift ;;
      --from) from=${2:-}; shift 2 || die "$1 needs a value" ;;
      --from=*) from=${1#*=}; shift ;;
      --force) force=true; shift ;;
      *) die "unknown option: $1" ;;
    esac
  done
  mkdir -p "$MCPSYNC_HOME"

  if [[ $SCOPE == user ]]; then
    if [[ -f $CONFIG_FILE && $force == false ]]; then
      ok "settings already exist: $CONFIG_FILE (use --force to redo)"
    else
      if [[ -z $chosen ]]; then
        if [[ -t 0 ]]; then
          info "Which editors do you use? (detected ones default to yes)"
          for ed in "${SUPPORTED_EDITORS[@]}"; do
            if editor_detected "$ed"; then d=Y; else d=N; fi
            if [[ $d == Y ]]; then ans="Y/n"; else ans="y/N"; fi
            read -r -p "  $ed [$ans] " ans || ans=""
            ans=${ans:-$d}
            if [[ $ans =~ ^[Yy] ]]; then chosen+="${chosen:+ }$ed"; fi
          done
        else
          for ed in "${SUPPORTED_EDITORS[@]}"; do
            if editor_detected "$ed"; then chosen+="${chosen:+ }$ed"; fi
          done
        fi
      fi
      for ed in $chosen; do is_supported "$ed" || die "unknown editor: $ed"; done
      write_config "$chosen"
      EDITORS=$chosen
      ok "wrote $CONFIG_FILE (editors: ${chosen:-none})"
    fi
  fi

  if [[ ! -f $SOURCE_FILE ]]; then
    printf '{\n  "mcpServers": {}\n}\n' > "$SOURCE_FILE"
    ok "created $SOURCE_FILE"
  else
    ok "source already exists: $SOURCE_FILE"
  fi
  if [[ -n $from ]]; then cmd_import "$from"; fi

  if [[ $SCOPE == project ]]; then p=" --project"; fi
  info ""
  info "Next:"
  info "  mcpsync$p edit               define servers; write secrets as \${VAR}"
  info "  mcpsync secret set VAR       store each secret once"
  info "  mcpsync$p sync --dry-run     preview"
  info "  mcpsync$p sync"
}

cmd_import() {
  local ed="" force=false a f kind val
  for a in "$@"; do
    case $a in
      --force) force=true ;;
      -*) die "unknown option: $a" ;;
      *) ed=$a ;;
    esac
  done
  [[ -n $ed ]] || die "usage: mcpsync import <editor> [--force]"
  is_supported "$ed" || die "unknown editor: $ed"
  f="$(editor_file "$ed")"
  [[ -n $f && -s $f ]] || die "nothing to import: ${f:-$ed has no file in this scope} not found"
  mkdir -p "$(dirname "$SOURCE_FILE")"

  engr import "$ed" "$(editor_format "$ed")" "$(servers_key "$ed")" "$f" "$SOURCE_FILE" "$force" \
    "$TMPROOT/source.new" > "$TMPROOT/import.notes"
  write_file "$SOURCE_FILE" "$TMPROOT/source.new"

  while IFS=$'\t' read -r kind val; do
    case $kind in
      added) ok "imported $val" ;;
      replaced) warn "replaced $val" ;;
      kept) info "  $val is already in the source (use --force to overwrite)" ;;
      secret) warn "$val looks like a hardcoded secret → replace it with \${VAR} in the source, then: mcpsync secret set VAR" ;;
    esac
  done < "$TMPROOT/import.notes"
  return 0
}

cmd_edit() {
  require_source
  local ed="${VISUAL:-${EDITOR:-}}"
  if [[ -z $ed ]]; then
    if [[ $PLATFORM == windows ]] && command -v notepad >/dev/null 2>&1; then ed=notepad
    elif command -v nano >/dev/null 2>&1; then ed=nano
    else ed=vi; fi
  fi
  $ed "$SOURCE_FILE"
  validate_source
  ok "$SOURCE_FILE is valid. Preview with: mcpsync$([[ $SCOPE == project ]] && echo ' --project') sync --dry-run"
}

# ---------------------------------------------------------------- secrets
source_var_names() { engr names "$SOURCE_FILE"; }

report_vars() {
  local names n where user_names="" user_wslenv=""
  names="$(source_var_names)"
  if [[ -z $names ]]; then info "  (the source references no \${VAR}s)"; return 0; fi
  if on_windows_env; then
    user_names="$(ps_run "$PS_USER_NAMES" || true)"
    user_wslenv="$(ps_run "$PS_USER_WSLENV" || true)"
  fi
  for n in $names; do
    where=""
    if [[ -n ${!n:-} ]]; then where+="${where:+, }this shell"; fi
    if grep -qixF "$n" <<< "$user_names"; then where+="${where:+, }Windows user env"; fi
    if tr ':' '\n' <<< "$user_wslenv" | cut -d/ -f1 | grep -qixF "$n"; then where+="${where:+, }WSLENV"; fi
    if [[ -f $SECRETS_FILE ]] && grep -q "^export $n=" "$SECRETS_FILE"; then where+="${where:+, }secrets.env"; fi
    if [[ -z $where ]]; then
      bad "$n — not set   → mcpsync secret set $n"
    else
      ok "$n — $where"
      if [[ $PLATFORM == windows && $where != *"this shell"* && $where == *"Windows user env"* ]]; then
        info "    ${C_D}set, but this shell started earlier; reopen terminals and editors${C_0}"
      fi
      if [[ $PLATFORM == wsl && $where != *"this shell"* && $where == *WSLENV* ]]; then
        info "    ${C_D}run 'wsl --shutdown' from Windows and reopen WSL to pick it up${C_0}"
      fi
      if [[ -n $user_names && $where == *"Windows user env"* && $where != *WSLENV* ]]; then
        info "    ${C_D}not shared with WSL → mcpsync secret wslenv${C_0}"
      fi
    fi
  done
  return 0
}

secrets_file_write() { # secrets_file_write NAME [VALUE]  (no VALUE = remove)
  local n=$1 tmp esc
  mkdir -p "$MCPSYNC_HOME"
  touch "$SECRETS_FILE"; chmod 600 "$SECRETS_FILE"
  tmp="$(mktemp "$MCPSYNC_HOME/.secrets.XXXXXX")"
  chmod 600 "$tmp"
  grep -v "^export $n=" "$SECRETS_FILE" > "$tmp" || true
  if (($# > 1)); then
    esc=${2//\'/\'\\\'\'}
    printf "export %s='%s'\n" "$n" "$esc" >> "$tmp"
  fi
  mv -f "$tmp" "$SECRETS_FILE"
}

secrets_profile_hint() {
  info "Load it from your shell profile (~/.bashrc, ~/.zshrc):"
  info "  [ -f \"$SECRETS_FILE\" ] && . \"$SECRETS_FILE\""
  if [[ $PLATFORM == mac ]]; then
    info "${C_D}Apps started from the Dock don't read shell profiles; start editors from a terminal (cursor ., code .) or use launchctl setenv.${C_0}"
  fi
}

secret_set() {
  local n=${1:-} v=""
  [[ $n =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "usage: mcpsync secret set NAME   (value is read from a hidden prompt or stdin)"
  if [[ -t 0 ]]; then
    read -r -s -p "Value for $n (hidden): " v; echo >&2
  else
    IFS= read -r v || true
  fi
  [[ -n $v ]] || die "empty value; nothing was set"
  if [[ $PLATFORM == windows || $PLATFORM == wsl ]]; then
    have_powershell || die "powershell.exe not found on PATH"
    MCPSYNC_NAME="$n" MCPSYNC_VAL="$v" ps_run "$PS_SET" >/dev/null
    ok "$n saved to your Windows user environment and shared with WSL (WSLENV)"
    info "${C_D}Reopen terminals and editors so they see it. In WSL: 'wsl --shutdown' first.${C_0}"
  else
    secrets_file_write "$n" "$v"
    ok "$n saved to $SECRETS_FILE"
    secrets_profile_hint
  fi
}

secret_unset() {
  local n=${1:-}
  [[ $n =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "usage: mcpsync secret unset NAME"
  if [[ $PLATFORM == windows || $PLATFORM == wsl ]]; then
    have_powershell || die "powershell.exe not found on PATH"
    MCPSYNC_NAME="$n" ps_run "$PS_UNSET" >/dev/null
    ok "$n removed from your Windows user environment and WSLENV"
  else
    secrets_file_write "$n"
    ok "$n removed from $SECRETS_FILE"
  fi
}

secret_wslenv() {
  on_windows_env || die "WSLENV only applies on Windows (Git Bash) or inside WSL"
  require_source
  local names
  names="$(source_var_names | paste -sd, -)"
  if [[ -z $names ]]; then info "the source references no \${VAR}s"; return 0; fi
  MCPSYNC_NAME="$names" ps_run "$PS_WSLENV_ADD" >/dev/null
  ok "WSLENV now shares: ${names//,/ }"
  info "${C_D}Run 'wsl --shutdown' and reopen WSL to pick it up.${C_0}"
}

cmd_secret() {
  local sub=${1:-list}
  if (($#)); then shift; fi
  case $sub in
    set) secret_set "$@" ;;
    unset|rm) secret_unset "$@" ;;
    list|ls) require_source; report_vars ;;
    wslenv) secret_wslenv ;;
    *) die "usage: mcpsync secret set|unset|list|wslenv [NAME]" ;;
  esac
}

cmd_doctor() {
  local risky line ed
  info "mcpsync $MCPSYNC_VERSION · platform: $PLATFORM · node $(node --version | tr -d '\r') · scope: $SCOPE"
  if [[ $SCOPE == user ]]; then
    if [[ -f $CONFIG_FILE ]]; then ok "settings: $CONFIG_FILE (editors: ${EDITORS:-none})"
    else warn "no settings yet → mcpsync init"; fi
  fi
  if [[ ! -f $SOURCE_FILE ]]; then warn "no source at $SOURCE_FILE → mcpsync init"; return 0; fi
  validate_source
  ok "source: $SOURCE_FILE ($(engr count "$SOURCE_FILE") servers)"

  risky="$(engr risky "$SOURCE_FILE")"
  if [[ -n $risky ]]; then
    while IFS= read -r line; do
      warn "$line — Claude Code sends credential variables like this as empty to remote servers; use a name of your own"
    done <<< "$risky"
  fi

  info "variables:"
  report_vars
  if [[ $SCOPE == user && -n ${EDITORS// /} ]]; then
    info "editors:"
    for ed in $EDITORS; do
      if ! is_supported "$ed"; then bad "$ed — unknown editor in $CONFIG_FILE"; continue; fi
      if editor_detected "$ed"; then ok "$ed — $(editor_file "$ed")"; else warn "$ed — not detected ($(editor_file "$ed"))"; fi
    done
  fi
  return 0
}

usage() {
  cat <<EOF
mcpsync $MCPSYNC_VERSION — one MCP config, synced to every editor you use.

Usage: mcpsync [--project[=DIR]] <command> [args]

Commands
  init [--editors "a b"] [--from EDITOR] [--force]
                         create settings + source; asks which editors you use
  edit                   open the source in \$VISUAL/\$EDITOR (notepad on Windows) and validate it
  list                   servers in the source, their type, editors and variables
  sync [--dry-run] [EDITOR...]
                         write the source into each editor's config (default: EDITORS)
  diff [EDITOR...]       same as sync --dry-run
  status                 per editor: in sync / out of sync / not created
  import EDITOR [--force]
                         copy servers from an editor's config into the source
  editors                supported editors and where their configs live
  secret set NAME        store a secret (Windows user env + WSLENV, else secrets.env)
  secret unset NAME      remove it
  secret list            which \${VAR}s the source uses and where each one is set
  secret wslenv          share every \${VAR} the source uses with WSL
  doctor                 check node, settings, source, variables and editors

Scope
  default                user-level configs; source: $MCPSYNC_HOME/mcp.json
  --project[=DIR]        project files (.mcp.json, .cursor/mcp.json, .codex/config.toml,
                         .vscode/mcp.json, .gemini/settings.json, .devin/mcp_config.json);
                         source: DIR/.mcpsync.json

Editors: ${SUPPORTED_EDITORS[*]}

Source format (Claude Code style; mcpsync translates per editor):
  {
    "mcpServers": {
      "dokploy": { "command": "npx", "args": ["-y", "@ahdev/dokploy-mcp"],
                   "env": { "DOKPLOY_API_KEY": "\${DOKPLOY_API_KEY}" } },
      "context7": { "type": "http", "url": "https://mcp.context7.com/mcp",
                    "headers": { "CONTEXT7_API_KEY": "\${CONTEXT7_API_KEY}" },
                    "x-editors": ["cursor", "claude-code"] }
    }
  }
EOF
}

# ---------------------------------------------------------------- main
main() {
  local args=() a cmd
  for a in "$@"; do
    case $a in
      --project) SCOPE=project; PROJECT_DIR=$PWD ;;
      --project=*) SCOPE=project; PROJECT_DIR=${a#*=} ;;
      *) args+=("$a") ;;
    esac
  done
  set -- ${args[@]+"${args[@]}"}
  cmd=${1:-help}
  if (($#)); then shift; fi

  case $cmd in
    help|-h|--help) usage; return 0 ;;
    version|-v|--version) echo "mcpsync $MCPSYNC_VERSION"; return 0 ;;
  esac

  TMPROOT="$(mktemp -d)"
  trap 'rm -rf "$TMPROOT"' EXIT
  setup_engine
  load_config

  if [[ $SCOPE == project ]]; then
    PROJECT_DIR="$(to_unix_path "$PROJECT_DIR")"
    [[ -d $PROJECT_DIR ]] || die "not a directory: $PROJECT_DIR"
    PROJECT_DIR="$(cd "$PROJECT_DIR" && pwd)"
    SOURCE_FILE="$PROJECT_DIR/.mcpsync.json"
    # keep the state key free of slashes so Git Bash doesn't rewrite it as a path
    STATE_PREFIX="project:$(printf '%s' "$PROJECT_DIR" | tr '/\\: ' '____'):"
    if [[ $FALLBACK == resolve ]]; then
      warn "FALLBACK=resolve is ignored for project files (they're often committed); using skip"
      FALLBACK=skip
    fi
  fi
  case $FALLBACK in skip|resolve|keep) ;; *) die "FALLBACK must be skip, resolve or keep (got '$FALLBACK')" ;; esac

  case $cmd in
    init)    cmd_init "$@" ;;
    edit)    cmd_edit ;;
    list|ls) cmd_list ;;
    sync)    cmd_sync "$@" ;;
    diff)    cmd_sync --dry-run "$@" ;;
    status)  cmd_status ;;
    import)  cmd_import "$@" ;;
    editors) cmd_editors ;;
    secret|secrets) cmd_secret "$@" ;;
    doctor)  cmd_doctor ;;
    *) die "unknown command: $cmd (see: mcpsync help)" ;;
  esac
}

main "$@"
